<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.darwin_world.MainController">

    <top>
        <HBox spacing="10" alignment="TOP_CENTER">
            <Button text="Start" onAction="#onStart"/>
            <Button text="Stop" onAction="#onStop"/>
            <Button text="Next Day" onAction="#onNextDay"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="mapcontainer">
            <Canvas fx:id="canvas" width="600" height="600"/>
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="5" alignment="CENTER">
            <Label fx:id="statsLabel1"/>
            <Label fx:id="statsLabel2"/>
        </VBox>
    </bottom>

</BorderPane>
