<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.darwin_world.StartController"
      spacing="10">

    <Label text="Simulation Configuration" style="-fx-font-size: 18px;"/>

    <HBox spacing="10">
        <Label text="Szerokość mapy:"/>
        <TextField fx:id="mapWidth" promptText="10"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Wysokość mapy:"/>
        <TextField fx:id="mapHeight" promptText="10"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Początkowa liczba roślin:"/>
        <TextField fx:id="initialPlantCount" promptText="10"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Wartość odżywcza roślin: "/>
        <TextField fx:id="plantNutritionalValue" promptText="5"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Liczba roślin pojawiających się każdego dnia: "/>
        <TextField fx:id="plantsToSpawnEachDay" promptText="2"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Początkowa liczba zwierząt:"/>
        <TextField fx:id="initialAnimalCount" promptText="5"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Początkowa energia zwierząt:"/>
        <TextField fx:id="initialAnimalEnergyValue" promptText="20"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Energia tracona każdego dnia przez zwierzęta "/>
        <TextField fx:id="animalDailyEnergyLoss" promptText="1"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Próg dobrego odżywienia zwierzęcia: "/>
        <TextField fx:id="animalWellFedThreshold" promptText="10"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Koszt reprodukcji zwierząt: "/>
        <TextField fx:id="animalReproductionCost" promptText="5"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Minimalna liczba mutacji: "/>
        <TextField fx:id="minMutationCount" promptText="0"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Maksymalna liczba mutacji: "/>
        <TextField fx:id="maxMutationCount" promptText="2"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Długość genomu: "/>
        <TextField fx:id="genomeLength" promptText="5"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Opóźnienie symulacji: "/>
        <TextField fx:id="delay" promptText="500"/>
    </HBox>

    <!-- Tutaj jeszcze do ogarnięcia wariant -->


    <Button text="Start Simulation" onAction="#onStart"/>

</VBox>
